{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {"name": "kube-memlens-node-context-producer"},
      "rules": [
        {"apiGroups": [""], "resources": ["nodes", "nodes/stats"], "verbs": ["get"]},
        {"apiGroups": ["memory.kubememlens.io"], "resources": ["ingestionepochs"], "verbs": ["get"]},
        {"apiGroups": ["memory.kubememlens.io"], "resources": ["nodesnapshots"], "verbs": ["create"]}
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "ClusterRole",
      "metadata": {"name": "kube-memlens-node-context-viewer"},
      "rules": [
        {"apiGroups": ["memory.kubememlens.io"], "resources": ["nodecontexts"], "verbs": ["get", "list"]},
        {"apiGroups": ["memory.kubememlens.io"], "resources": ["nodecontexts/history", "nodecontexts/analysis"], "verbs": ["get"]}
      ]
    }
  ]
}
