# The owned fixture has two measured workers and possibly a control-plane Node.
# Charge ordering is not a stable way to choose the requested qualified Node.
# A full-name text filter may also match a suffixed sibling (worker / worker2),
# so confirm the actual detail title rather than assuming the first filtered row.
proc select_node_cockpit {node} {
  global timeout
  if {![regexp {^[a-z0-9][a-z0-9.-]{0,252}$} $node]} {
    puts stderr "Node PTY requires a valid target Node"
    exit 2
  }
  send -- "/"
  expect {
    -re {search:} {}
    timeout { puts stderr "Node PTY filter did not open"; exit 1 }
    eof { puts stderr "Node PTY exited before target selection"; exit 1 }
  }
  send -s -- "$node\r"
  for {set attempt 0} {$attempt < 3} {incr attempt} {
    send -- "e"
    expect {
      -re {Node cockpit: ([a-z0-9.-]+)[\s\x1b]} {
        if {$expect_out(1,string) eq $node} {
          puts "PASS requested Node selected"
          return
        }
      }
      timeout { puts stderr "Node PTY target detail did not open"; exit 1 }
      eof { puts stderr "Node PTY exited during target selection"; exit 1 }
    }
    send -- "h"
    expect {
      -re {CHARGE} {}
      timeout { puts stderr "Node PTY did not return to the Node table"; exit 1 }
      eof { puts stderr "Node PTY exited during target selection"; exit 1 }
    }
    send -- "j"
  }
  puts stderr "Node PTY did not select the requested Node"
  exit 1
}

# Capture confirmation must tolerate a coalesced frame: the renderer may leave
# "Redacted " from the input prompt on screen and write only the changed suffix.
proc require_node_capture {capture} {
  global timeout
  set original_timeout $timeout
  set deadline [expr {[clock milliseconds] + $timeout * 1000}]
  set timeout 1
  set confirmed 0
  while {[clock milliseconds] < $deadline} {
    expect {
      -re {Node capture written} { set confirmed 1 }
      -re {Node evidence changed during the read} {
        puts stderr "Node PTY capture rejected a changing source sample"
        exit 1
      }
      -re {invalid Node incident|invalid Node analysis|invalid Node record|invalid Node history} {
        puts stderr "Node PTY capture failed schema or evidence validation"
        exit 1
      }
      -re {access is forbidden|API is unavailable|unexpected response} {
        puts stderr "Node PTY capture failed its authorised API read"
        exit 1
      }
      timeout {}
      eof { puts stderr "Node PTY exited before capture confirmation"; exit 1 }
    }
    if {$confirmed && [file isfile $capture]} {
      puts "PASS private Node capture written"
      set timeout $original_timeout
      return
    }
  }
  puts stderr "Node PTY capture timed out: file_created=[file isfile $capture] confirmation_seen=$confirmed"
  exit 1
}
