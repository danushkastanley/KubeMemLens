{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/danushkastanley/KubeMemLens/blob/main/hack/release/candidate-manifest.schema.json",
  "title": "KubeMemLens release candidate manifest",
  "description": "Immutable identities and digests required to promote an evaluated release candidate without rebuilding it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_tag",
    "intended_ga_tag",
    "source_commit",
    "cli_archives",
    "image",
    "chart",
    "workflow_identity"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidate_tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*$"
    },
    "intended_ga_tag": {
      "type": "string",
      "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "cli_archives": {
      "type": "object",
      "minProperties": 6,
      "maxProperties": 6,
      "additionalProperties": false,
      "patternProperties": {
        "^kube-memlens_[0-9]+\\.[0-9]+\\.[0-9]+_(darwin|linux)_(amd64|arm64)\\.tar\\.gz$": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "^kube-memlens_[0-9]+\\.[0-9]+\\.[0-9]+_windows_(amd64|arm64)\\.zip$": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^ghcr\\.io/danushkastanley/candidates/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*/kube-memlens$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "package"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^ghcr\\.io/danushkastanley/candidates/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*/charts/kube-memlens$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "sha256"],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^kube-memlens-[0-9]+\\.[0-9]+\\.[0-9]+\\.tgz$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "workflow_identity": {
      "type": "string",
      "pattern": "^https://github\\.com/danushkastanley/KubeMemLens/\\.github/workflows/candidate\\.yml@refs/tags/v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-rc\\.[1-9][0-9]*$"
    }
  }
}
