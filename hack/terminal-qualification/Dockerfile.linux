FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        alacritty=0.13.2-1ubuntu1 \
        ca-certificates=20260601~24.04.1 \
        fonts-dejavu-core=2.37-8 \
        fonts-noto-cjk=1:20230817+repack1-3 \
        fonts-noto-color-emoji=2.047-0ubuntu0.24.04.1 \
        iproute2=6.1.0-1ubuntu6.4 \
        jq=1.7.1-3ubuntu0.24.04.2 \
        kitty=0.32.2-1ubuntu0.4 \
        openbox=3.6.1-12build5 \
        openssh-client=1:9.6p1-3ubuntu13.18 \
        openssh-server=1:9.6p1-3ubuntu13.18 \
        scrot=1.10-1build2 \
        tmux=3.4-1ubuntu0.1 \
        xdotool=1:3.20160805.1-5build1 \
        xfonts-base=1:1.0.5+nmu1 \
        xterm=390-1ubuntu3 \
        xvfb=2:21.1.12-1ubuntu1.6 \
    && rm -rf /var/lib/apt/lists/*

ENV DISPLAY=:99 \
    HOME=/tmp/qualification-home \
    KITTY_DISABLE_WAYLAND=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    LIBGL_ALWAYS_SOFTWARE=1

ARG QUALIFICATION_UID=65532
RUN useradd --create-home --home-dir /tmp/qualification-home --uid "${QUALIFICATION_UID}" qualification

USER ${QUALIFICATION_UID}
WORKDIR /qualification
