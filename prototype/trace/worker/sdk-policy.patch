@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: Apache-2.0
+// KubeMemLens worker policy additions to the pinned SDK.
+package ebpfoperator
+
+import (
+	"errors"
+	"maps"
+	"slices"
+
+	"github.com/cilium/ebpf"
+	"github.com/inspektor-gadget/inspektor-gadget/pkg/operators"
+)
+
+// ConstrainedWorkerPolicyVersion identifies the mandatory worker-only policy.
+const ConstrainedWorkerPolicyVersion = 1
+
+type constrainedAttachValidator interface {
+	BeforeAttach(map[string]*ebpf.Map) error
+}
+
+func constrainedBeforeAttach(ctx operators.GadgetContext, owned map[string]*ebpf.Map) error {
+	if err := ctx.Context().Err(); err != nil {
+		return err
+	}
+	validator, ok := ctx.(constrainedAttachValidator)
+	if !ok {
+		return errors.New("constrained worker requires pre-attach validation")
+	}
+	return validator.BeforeAttach(maps.Clone(owned))
+}
+
+func constrainedProgrammeNames(programmes map[string]*ebpf.ProgramSpec) []string {
+	return slices.Sorted(maps.Keys(programmes))
+}
