+// ValidateConstrainedAttachment rejects unsupported classes before any map load.
+// The worker separately validates signed object identity, exact hooks and helpers.
+func ValidateConstrainedAttachment(p *ebpf.ProgramSpec) error {
+	if p == nil || p.AttachTo == "" {
+		return fmt.Errorf("missing constrained attachment")
+	}
+	switch p.Type {
+	case ebpf.TracePoint:
+		category, name, ok := strings.Cut(p.AttachTo, "/")
+		if !ok || category == "" || name == "" || strings.Contains(name, "/") || p.SectionName != "tracepoint/"+p.AttachTo || p.AttachType != ebpf.AttachNone {
+			return fmt.Errorf("invalid constrained tracepoint")
+		}
+	case ebpf.Tracing:
+		if (p.AttachType == ebpf.AttachTraceFEntry && p.SectionName == "fentry/"+p.AttachTo) || (p.AttachType == ebpf.AttachTraceFExit && p.SectionName == "fexit/"+p.AttachTo) {
+			return nil
+		}
+		return fmt.Errorf("unsupported constrained tracing attachment")
+	default:
+		return fmt.Errorf("unsupported constrained programme type")
+	}
+	return nil
+}
 
